<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#090014">
<title>Birthday Girl 🎂</title>
<style>
:root{--pink:#ff3d81;--purple:#7c3aed;--white:#fff}
*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#08000f;color:#fff}
body{min-height:100vh;display:grid;place-items:center;overflow:hidden}
#stars{position:fixed;inset:0;width:100%;height:100%;z-index:0}
.glow{position:fixed;width:45vw;height:45vw;max-width:520px;max-height:520px;border-radius:50%;filter:blur(100px);opacity:.28;z-index:0}
.g1{background:#ff1f72;left:-14vw;top:-15vw}.g2{background:#7438ff;right:-14vw;bottom:-15vw}
.card{position:relative;z-index:2;width:min(92vw,720px);padding:38px 25px 30px;text-align:center;border:1px solid #ffffff2b;background:#ffffff12;backdrop-filter:blur(20px);border-radius:30px;box-shadow:0 25px 100px #0009}
.badge{display:inline-block;padding:8px 14px;border-radius:999px;background:#ffffff12;font-size:11px;letter-spacing:1.8px;text-transform:uppercase}
.cake{font-size:76px;margin-top:15px;animation:bob 1.8s ease-in-out infinite;filter:drop-shadow(0 0 24px #ff5a9d)}
@keyframes bob{50%{transform:translateY(-10px) rotate(2deg)}}
h1{font-size:clamp(42px,10vw,76px);line-height:.93;margin:10px 0 16px;background:linear-gradient(90deg,#fff,#ffafd0,#cbbdff,#fff);background-size:300%;color:transparent;background-clip:text;-webkit-background-clip:text;animation:shine 5s linear infinite}
@keyframes shine{to{background-position:300%}}
.sub{max-width:560px;margin:0 auto 20px;font-size:17px;line-height:1.6;color:#ffffffd4}
#count{font-weight:800;color:#ffd3e4;margin:8px 0 20px}
button{appearance:none;border:0;border-radius:999px;padding:16px 25px;color:white;background:linear-gradient(135deg,var(--pink),var(--purple));font-size:16px;font-weight:900;cursor:pointer;box-shadow:0 12px 35px #ff3d8150;transition:transform .18s}
button:hover{transform:translateY(-2px) scale(1.03)}button:active{transform:scale(.96)}
#surprise{margin-top:25px;animation:reveal .65s cubic-bezier(.2,.9,.2,1)}
.hidden{display:none!important}
@keyframes reveal{0%{opacity:0;transform:scale(.55);filter:blur(10px)}60%{transform:scale(1.06)}100%{opacity:1;transform:scale(1);filter:blur(0)}}
.wait{font-size:clamp(27px,6vw,43px);font-weight:950;margin:0 0 10px}
.treat{font-size:clamp(23px,5vw,34px);font-weight:950;background:linear-gradient(90deg,#ffd0e3,#fff,#d8cbff);color:transparent;background-clip:text;-webkit-background-clip:text}
.small{margin:10px 0 0;color:#ffffffaa;font-size:15px}
.footer{margin-top:25px;color:#ffffff66;font-size:11px}
#blackout{position:fixed;inset:0;background:#000;z-index:20;display:grid;place-items:center;text-align:center;opacity:0;pointer-events:none;transition:opacity .5s}
#blackout.show{opacity:1;pointer-events:auto}
#blackout .text{font-size:clamp(30px,8vw,70px);font-weight:950;letter-spacing:-2px}
#blackout .subtext{margin-top:12px;color:#ffffff99;font-size:16px}
#burst{position:fixed;inset:0;z-index:30;pointer-events:none}
.particle{position:fixed;left:50%;top:50%;font-size:25px;animation:explode 1.7s ease-out forwards}
@keyframes explode{to{transform:translate(var(--x),var(--y)) rotate(var(--r));opacity:0}}
.shake{animation:shake .5s ease}
@keyframes shake{20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-6px)}80%{transform:translateX(6px)}}
@media(max-width:500px){.card{padding:30px 18px 25px}.cake{font-size:64px}.sub{font-size:16px}}
</style>
</head>
<body>
<canvas id="stars"></canvas>
<div class="glow g1"></div><div class="glow g2"></div>

<main class="card" id="card">
  <div class="badge">⚠️ Extremely Important Birthday Notice</div>
  <div class="cake">🎂</div>
  <h1>Happy Birthday,<br>Birthday Girl! ✨</h1>
  <p class="sub">The universe apparently decided that one particular day needed <b>extra sparkle, extra chaos and one very special person.</b></p>
  <div id="count">Loading birthday magic…</div>
  <button id="btn" type="button">DO NOT PRESS THIS 👀</button>

  <section id="surprise" class="hidden">
    <p class="wait">YOU ACTUALLY PRESSED IT! 👀😂</p>
    <div class="treat">Now you owe me a birthday treat 😌🎂</div>
    <p class="small">No excuses accepted. 😂</p>
  </section>
  <div class="footer">Made with questionable amounts of effort &amp; good intentions 😌</div>
</main>

<div id="blackout" aria-hidden="true">
  <div>
    <div class="text" id="blackText">WAIT… 👀</div>
    <div class="subtext">You were specifically told not to press it.</div>
  </div>
</div>
<div id="burst"></div>

<script>
(() => {
  const canvas=document.getElementById("stars"),ctx=canvas.getContext("2d");
  let stars=[];
  function resize(){
    canvas.width=innerWidth*devicePixelRatio; canvas.height=innerHeight*devicePixelRatio;
    canvas.style.width=innerWidth+"px"; canvas.style.height=innerHeight+"px";
    ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
    stars=Array.from({length:110},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.6+.25,s:Math.random()*.5+.1}));
  }
  function draw(){
    ctx.clearRect(0,0,innerWidth,innerHeight);ctx.fillStyle="rgba(255,255,255,.75)";
    for(const s of stars){ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fill();s.y+=s.s;if(s.y>innerHeight)s.y=0}
    requestAnimationFrame(draw);
  }
  addEventListener("resize",resize);resize();draw();

  const target=new Date("2026-08-16T00:00:00+05:30").getTime();
  function countdown(){
    const d=Math.max(0,target-Date.now());
    const el=document.getElementById("count");
    if(!d){el.textContent="IT’S BIRTHDAY TIME! 🎉🎂";return}
    const h=Math.floor(d/3600000),m=Math.floor(d%3600000/60000),s=Math.floor(d%60000/1000);
    el.textContent=`Birthday countdown: ${h}h ${m}m ${s}s 🎉`;
  }
  countdown();setInterval(countdown,1000);

  const blackout=document.getElementById("blackout"), burst=document.getElementById("burst");
  const emojis=["💖","✨","🎉","💫","🫶","🎂","😂","🥳","💗"];
  function explode(){
    burst.innerHTML="";
    for(let i=0;i<90;i++){
      const p=document.createElement("span");p.className="particle";
      p.textContent=emojis[Math.floor(Math.random()*emojis.length)];
      const a=Math.random()*Math.PI*2, dist=120+Math.random()*Math.max(innerWidth,innerHeight)*.75;
      p.style.setProperty("--x",Math.cos(a)*dist+"px");
      p.style.setProperty("--y",Math.sin(a)*dist+"px");
      p.style.setProperty("--r",(Math.random()*720-360)+"deg");
      p.style.animationDelay=(Math.random()*.18)+"s";
      burst.appendChild(p);
    }
    setTimeout(()=>burst.innerHTML="",2200);
  }

  document.getElementById("btn").addEventListener("click",()=>{
    blackout.classList.add("show");
    blackout.setAttribute("aria-hidden","false");
    setTimeout(()=>{
      document.getElementById("blackText").textContent="OKAY… YOU ASKED FOR IT 😈";
    },850);
    setTimeout(()=>{
      blackout.classList.remove("show");
      blackout.setAttribute("aria-hidden","true");
      document.getElementById("surprise").classList.remove("hidden");
      document.getElementById("card").classList.add("shake");
      explode();
      setTimeout(()=>document.getElementById("card").classList.remove("shake"),600);
    },1900);
  });
})();
</script>
</body>
</html>
